# ASR-PEFT-DP Backend Configuration

# Model Configuration
BASE_MODEL=NbAiLab/nb-whisper-medium
# Device will auto-detect: CUDA (NVIDIA) > MPS (Apple Silicon) > CPU
# You can override by setting: DEVICE=cuda or DEVICE=mps or DEVICE=cpu
# Leave commented for auto-detection (recommended)
# DEVICE=cuda

# Audio Processing
MIN_SILENCE_MS=2000
KEEP_SILENCE_MS=300
MAX_CHUNK_LENGTH_MS=30000

# Training Configuration
MANUAL_RETRAIN_N=20  # Number of corrections before automatic retraining
BATCH_SIZE=4
EPOCHS=3
MAX_GRAD_NORM=1.0

# Differential Privacy (Feature Flag)
# Set to "true" to enable differential privacy during training
# Set to "false" for standard PEFT fine-tuning without DP (CISK experiment)
ENABLE_DIFFERENTIAL_PRIVACY=false

# Hyperparameters (for single-run training)
LEARNING_RATE=5e-5
TARGET_EPSILON=5.0
TARGET_DELTA=1e-5
LORA_R=8
LORA_ALPHA=32
LORA_DROPOUT=0.05

# Grid Search (set to "true" to enable hyperparameter search)
RUN_GRID_SEARCH=false

# Backend URL (for training script to notify model reload)
BACKEND_URL=http://localhost:8000

# MLflow Configuration
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=Whisper LoRA DP Tuning

# Data Directories (relative to backend working directory)
AUDIO_DIR=data/audio
RECORD_DIR=data/records
ADAPTER_DIR=data/lora_output

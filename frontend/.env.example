# ASR-PEFT-DP Frontend Configuration

# Backend API URL
VITE_BACKEND_URL=http://localhost:8000

# WhisperLive WebSocket URL (for streaming mode)
VITE_WHISPERLIVE_WS_URL=ws://localhost:9090

# Feature Flags
VITE_ENABLE_TRAINING=true         # Enable LoRA training features
VITE_ENABLE_STREAMING=false       # Enable WhisperLive streaming mode
VITE_ENABLE_BATCH_UPLOAD=true    # Enable batch file upload

# Polling interval for WER updates (milliseconds)
VITE_WER_POLL_INTERVAL=70000

# UI Configuration
VITE_RECORDS_PER_PAGE=50

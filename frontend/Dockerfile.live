FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including adapter-node
RUN npm ci && npm install -D @sveltejs/adapter-node

# Copy source
COPY . .

# Update svelte config for node adapter
RUN echo "import adapter from '@sveltejs/adapter-node';" > svelte.config.js.new && \
    echo "import { vitePreprocess } from '@sveltejs/vite-plugin-svelte';" >> svelte.config.js.new && \
    echo "const config = { preprocess: vitePreprocess(), kit: { adapter: adapter() } };" >> svelte.config.js.new && \
    echo "export default config;" >> svelte.config.js.new && \
    mv svelte.config.js.new svelte.config.js

# Set environment variable for build
ENV VITE_RTSP_BACKEND_URL=http://192.168.4.11:30002

# Build the app
RUN npm run build

# Production stage
FROM node:18-alpine

WORKDIR /app

# Copy built app
COPY --from=builder /app/build ./build
COPY --from=builder /app/package*.json ./

# Install production dependencies only
RUN npm ci --only=production

EXPOSE 3000

ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["node", "build"]

